# ==========================================
# CRM SERVICE (puerto 3002)
# Clientes, Productos, Ventas, Firmas, Grabaciones, Contratos
# ==========================================

# =====================
# BASE DE DATOS
# =====================
# Misma instancia PostgreSQL que core-service (BD compartida)
DATABASE_URL="postgresql://postgres:1234@localhost:5432/crm?schema=public&connection_limit=10"

# =====================
# PUERTO
# =====================
PORT=3002

# =====================
# ENTORNO
# =====================
NODE_ENV=development

# =====================
# JWT
# Mismo secreto que core-service para verificar tokens
# =====================
JWT_SECRET=

# =====================
# COMUNICACIÓN INTERNA
# Clave compartida con todos los microservicios
# =====================
INTERNAL_API_KEY=calls-internal-secret-2026

# =====================
# CORS
# =====================
ALLOW_ALL_CORS=true
CORS1=http://localhost:5173
CORS2=http://192.168.1.47:5173
CORS3=http://elitedeventas.duckdns.org

# =====================
# FRONTEND URL
# =====================
FRONTEND_URL=http://localhost:5173

# =====================
# AUTENTICACIÓN POR COOKIE (PRODUCCIÓN)
# Ver documentación en core-service/.env.example
# =====================
# USE_COOKIE_AUTH=true

# =====================
# URLS DE OTROS SERVICIOS
# =====================
CALLS_SERVICE_URL=http://localhost:3003
SMS_CONNECTOR_URL=http://localhost:3005

# =====================
# MÉTRICAS
# =====================
ENABLE_METRICS=false
PROMETHEUS_PORT=9091

# =====================
# 1SKORE - SCORING DE CLIENTES
# Credenciales del servidor (no exponer al browser)
# =====================
SKORE_USER=
SKORE_PASSWORD=
# URL base de la API de 1Skore (por defecto https://ws.1skore.com)
# SKORE_BASE_URL=https://ws.1skore.com

# =====================
# LLEIDA.NET - FIRMA ELECTRÓNICA (Click & Sign)
# =====================
LLEIDA_API_KEY=your_api_key_here
LLEIDA_USER=your_username_here
# true = mock local (no llama a Lleida, ideal para desarrollo)
LLEIDA_USE_MOCK=true
LLEIDA_CONFIG_ID_CORREO=12345
LLEIDA_CONFIG_ID_SMS=
