# ==========================================
# FRONTEND - BUSCADOR ELITE 
# ==========================================

# =====================
# BACKEND
# =====================
# URL del backend
VITE_API_URL=http://url-del-backend:puerto/api

# =============================
# HOST Y PUERTO DEL FRONTEND
# =============================
VITE_DEV_HOST=http://100.100.100.100
VITE_DEV_PORT=5173

# =====================
# 1SKORE (REST API)
# Las credenciales van en crm-service (SKORE_USER / SKORE_PASSWORD)
# =====================
VITE_1SKORE_TARGET=https://ws.1skore.com

# =====================
# APLICACIÓN
# =====================
VITE_APP_NAME=CRM Elite Ventas
VITE_APP_VERSION=1.0.0
VITE_LOG_LEVEL=info

# =====================
# MÓDULO LLAMADAS
# =====================
VITE_CALLS_API_URL=http://localhost:3003/api
VITE_CALLS_WS_URL=ws://localhost:3003/ws

# =====================
# MODO DEMO
# =====================
# true = muestra botones de simulación (firma demo, etc.)
# false o no definido = oculta los botones en producción
VITE_DEMO_MODE=false