# ==========================================
# CORE SERVICE (puerto 3001)
# Auth, Usuarios, Configuración, IPs permitidas
# ==========================================

# =====================
# BASE DE DATOS
# =====================
DATABASE_URL="postgresql://postgres:1234@localhost:5432/crm?schema=public&connection_limit=10"

# =====================
# PUERTO
# =====================
PORT=3001

# =====================
# ENTORNO
# =====================
NODE_ENV=development

# =====================
# JWT - AUTENTICACIÓN
# =====================
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# =====================
# COMUNICACIÓN INTERNA
# Clave compartida con todos los microservicios
# =====================
INTERNAL_API_KEY=calls-internal-secret-2026

# =====================
# CORS
# true = cualquier IP puede acceder
# false = solo IPs en CORS1/CORS2/CORS3
# =====================
ALLOW_ALL_CORS=true
CORS1=http://localhost:5173
CORS2=http://192.168.1.47:5173
CORS3=http://elitedeventas.duckdns.org

# =====================
# FRONTEND URL (para cookies / redirects)
# =====================
FRONTEND_URL=http://localhost:5173

# =====================
# AUTENTICACIÓN POR COOKIE (PRODUCCIÓN)
# En producción se DEBE activar USE_COOKIE_AUTH=true para enviar
# los tokens como httpOnly cookies en lugar de en el cuerpo JSON.
# Esto protege contra ataques XSS que puedan leer localStorage.
# Requiere HTTPS y configurar correctamente FRONTEND_URL + CORS.
# =====================
# USE_COOKIE_AUTH=true

# =====================
# RATE LIMIT
# =====================
DISABLE_AUTH_RATE_LIMIT=false

# =====================
# MÉTRICAS
# =====================
ENABLE_METRICS=false
PROMETHEUS_PORT=9090
