PORT=3005
NODE_ENV=development

# Clave compartida con crm-service
INTERNAL_API_KEY=your-internal-key

# true = no llama a Lleida, simula la respuesta (para desarrollo)
USE_MOCK=true

# ── Lleida.net - Click & Sign (entrega de firma vía SMS) ──────────────
LLEIDA_API_KEY=your_api_key_here
LLEIDA_USER=your_username_here
# URL base de la API (no cambiar en producción)
LLEIDA_BASE_URL=https://api.lleida.net/cs/v1
