PORT=3004
NODE_ENV=development

# Proveedor activo: mock | twilio | vicidial
PROVIDER=mock

# URL del calls-service (para enviar CallEventDTOs en modo mock)
CALLS_SERVICE_URL=http://localhost:3003

# Clave compartida entre calls-service y calls-connector
INTERNAL_API_KEY=calls-internal-secret-2026

# ── Twilio (solo si PROVIDER=twilio) ──────────────────────
# URL publica de este servidor -- Twilio necesita alcanzarlo para TwiML y webhooks
# En local usa ngrok: ngrok http 3004  ->  https://xxxx.ngrok.io
CONNECTOR_PUBLIC_URL=https://xxxx.ngrok.io

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numero E.164 de Twilio que aparece como caller ID
TWILIO_NUMBER=+34900000000

# ── Vicidial (solo si PROVIDER=vicidial) ──────────────────
# El agente debe estar logueado en Vicidial antes de iniciar llamadas.
# agentExtension en el CallRequestDTO debe ser el agent_user de Vicidial (ej: "6666")
VICIDIAL_URL=http://192.168.1.x
VICIDIAL_USER=VD_admin
VICIDIAL_PASS=
# Opcionales -- algunos servidores los requieren en external_dial:
VICIDIAL_CAMPAIGN_ID=OUTBOUND
VICIDIAL_CALL_SERVER_IP=192.168.1.x
